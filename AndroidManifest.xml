<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.holi.prdbus">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.unionpay" />
    </queries>
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_sayu"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <provider
            android:name="com.holi.prdbus.UpdateFileProvider"
            android:authorities="com.holi.prdbus.update-files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity android:name="com.holi.prdbus.SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.holi.prdbus.PrivacyActivity" android:exported="false" />
        <activity android:name="com.holi.prdbus.RailActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.holi.prdbus.RailTrainActivity" android:exported="false" />
        <activity android:name="com.holi.prdbus.RegionalBusActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="com.holi.prdbus.MetroNetworkActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.holi.prdbus.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
        </activity>
        <activity
            android:name="com.holi.prdbus.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.holi.prdbus.MetroActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.holi.prdbus.LineDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.holi.prdbus.MetroLineActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.holi.prdbus.TransitActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.holi.prdbus.TransitDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>
</manifest>
