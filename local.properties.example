# Copy to local.properties (Git ignored). Environment variables take precedence.
# Use forward slashes in Windows paths. JDK 17 and Android SDK Platform 35 required.
# JAVA_HOME=/path/to/jdk-17
# sdk.dir=/path/to/android-sdk
# ANDROID_BUILD_TOOLS=35.0.0
# ANDROID_COMPILE_SDK=35

# The source build is independently signed and installs alongside the official app.
# APP_APPLICATION_ID=com.holi.prdbus.opensource
# APP_VERSION_NAME=2.1.25-source
# APP_VERSION_CODE=239

# Optional local data you are authorized to use. Never commit this directory.
# APP_ASSETS_OVERLAY=.private-assets

# Optional production signing: all four are required together. Keep these private.
# Prefer environment variables in a private release environment.
# RELEASE_STORE_FILE=/private/path/release.p12
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=

# AMap is configured by the user inside the app; there is no shared embedded Key.
